{
  "schema": "dale-os/shipping-lanes/v1",
  "note": "Example lane map. Copy it as shipping-lanes.json and replace the globs with your repository's paths. Keep the reviewer's rubric, prompt and scripts, and this file itself, in L3: they judge every later PR, so a change to them is a change to the judge. A script gives each changed path (both sides of every rename) the lane of the first entry whose globs match; an entry marked only_if_all_paths_match is skipped unless every changed path matches it. The PR takes the highest lane any path reaches (L3 > L2 > L1 > L0). If the list of changed files or this file cannot be read, the PR is L3.",
  "integration_branch": "main",
  "lanes": [
    {
      "id": "L3",
      "name": "held",
      "paths": [
        ".github/workflows/**",
        ".github/CODEOWNERS",
        "REVIEW.md",
        "scripts/agent-review/**",
        "shipping-lanes.json",
        "**/migrations/**",
        "scripts/release/**",
        "scripts/merge/**",
        "**/auth/**",
        "**/billing/**",
        ".claude/settings.json"
      ],
      "requires": [
        "required-checks-green-on-head",
        "agent-review",
        "second-vendor-review",
        "person-lands"
      ]
    },
    {
      "id": "L2",
      "name": "truth",
      "paths": [
        "src/ledger/**",
        "src/sync/**",
        "src/import/**",
        "src/evidence/**"
      ],
      "requires": [
        "required-checks-green-on-head",
        "affected-tests",
        "agent-review",
        "second-vendor-review"
      ]
    },
    {
      "id": "L0",
      "name": "docs",
      "paths": [
        "docs/**",
        "**/*.md"
      ],
      "only_if_all_paths_match": true,
      "requires": [
        "required-checks-green-on-head",
        "agent-review"
      ]
    },
    {
      "id": "L1",
      "name": "ordinary",
      "paths": [
        "**"
      ],
      "requires": [
        "required-checks-green-on-head",
        "agent-review"
      ]
    }
  ]
}
